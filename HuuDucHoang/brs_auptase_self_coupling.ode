## Diekman et al 2017 J. Neurophys. Closed-loop breathing regulation model 
# with an additional autapse representing the effect of a network of identical 
# fully synchronized cells.

param W=0.0

param C=21
param gnap=2.8
param gna=28
param gk=11.2
param gl=2.8
param ena=50
param ek=-85
param el=-65
param esyn=0

param theta_mp=-40
param sigma_mp=-6
param theta_h=-48
param sigma_h=6
param taumax_h=10000

param theta_m=-34
param sigma_m=-5
param theta_n=-29
param sigma_n=-4
param taumax_n=10

param tau_s=5
param k_r=1
param theta_s=-10
param sigma_s=-5

param r=0.001
param tmax=1
param vt=2
param kp=5

param e1=0.4
param e2=0.0025
param vol0=2

param po2ext=149.73
param rgas=62.364
param temp=310
param taulb=500

# param m=8e-6
param m=1.4e-5

param volblood=5
param eta=204
param beta_o2=0.03
param zeta = 2.232134e-4

param c_o2=2.5
param k_o2=26

param phi=0.3
param theta_o2=85
param sigma_o2=30
param ksig=100

# CPG gates & currents
mp_inf  = 1/(1+exp((v - theta_mp)/sigma_mp))
h_inf   = 1/(1+exp((v - theta_h)/sigma_h))
tau_h   = taumax_h/cosh((v - theta_h)/(2*sigma_h))
inap    = gnap*mp_inf*h*(v - ena)

m_inf   = 1/(1+exp((v - theta_m)/sigma_m))
ina     = gna*(m_inf^3)*(1-n)*(v - ena)

n_inf   = 1/(1+exp((v - theta_n)/sigma_n))
tau_n   = taumax_n/cosh((v - theta_n)/(2*sigma_n))
ik      = gk*(n^4)*(v - ek)
il      = gl*(v - el)

s_inf   = 1/(1+exp((v - theta_s)/sigma_s))
isyn    = W*s*(v - esyn)

# Motor-pool proxy (N=1; for N>1 you'd average)
NT      = 1/(1+exp(-(v - vt)/kp))
tpop    = tmax*NT

# Lung mechanics: raw and clipped inflow (matches MATLAB's dvolrhs)
vol_raw     = -e2*(vol - vol0) + e1*alpha
vol_dot     = max(vol_raw, 0)

# O2 physio
sa_o2       = (po2blood^(c_o2))/(po2blood^(c_o2) + (k_o2)^(c_o2))
dSaO2_dPO2  = (c_o2*(po2blood^((c_o2)-1))) * (1/(po2blood^(c_o2) + k_o2^(c_o2)) - (po2blood^(c_o2))/(po2blood^(c_o2) + k_o2^(c_o2))^2 )
CaO2        = eta*sa_o2 + beta_o2*po2blood
Jlb         = (1/taulb)*(po2lung - po2blood)*(vol/(rgas*temp))
Jbt         = m*CaO2*zeta

# Chemosensory tonic current
gton        = phi*(1 - tanh((po2blood - theta_o2)/sigma_o2))
iton        = gton*(v - esyn)

vdot       = -(inap + ina + ik + il + iton + isyn)/C
v'         = -(inap + ina + ik + il + iton + isyn)/C
n'         = (n_inf - n)/tau_n
h'         = (h_inf - h)/tau_h
s'         = ((1 - s)*s_inf - k_r*s)/tau_s
alpha'     = r*tpop*(1 - alpha) - r*alpha
vol'       = vol_raw
po2lung'   = (1/vol)*(po2ext - po2lung)*vol_dot - Jlb*(rgas*temp/vol)
po2blood'  = (Jlb - Jbt)/(zeta*(beta_o2 + eta*dSaO2_dPO2))


# ---------------------
# Initial conditions
# ---------------------
# init v        = -58.5754
# init n        = 0.0006
# init h        = 0.7252
# init s        = 0
# init alpha    = 0.0010
# init vol      = 2.2665
# init po2lung  = 103.3461
# init po2blood = 102.2224

init v        = -47.04
init n        = 0.01076
init h        = 0.34119
init s        = 0.00063186
init alpha    = 0.002913
init vol      = 2.445775
init po2lung  = 17.820
init po2blood = 17.1124

aux gton_fig     = phi*(1 - tanh((po2blood - theta_o2)/sigma_o2))
aux vol_raw_fig  = -e2*(vol - vol0) + e1*alpha
aux vol_in_fig   = max(vol_raw,0)
aux Jlb_fig      = (1/taulb)*(po2lung - po2blood)*(vol/(rgas*temp))
aux SaO2_fig     = (po2blood^c_o2)/(po2blood^c_o2 + k_o2^c_o2)
aux CaO2_fig     = eta*sa_o2 + beta_o2*po2blood
aux Jbt_fig      = m*CaO2*(volblood/22400)
aux pBdot_fig    = (Jlb - Jbt)/((volblood/22400)*(beta_o2 + eta*dSaO2_dPO2))
aux vdot_fig     = -(inap + ina + ik + il + iton + isyn)/C

# ---------------------
# Numerics & display
# ---------------------
@ total=40000, dt=0.1, meth=cvode, maxstor=10000000,bounds=100000000000
@ tol=1e-8, atol=1e-8
@ xlo=0, xhi=40000, ylo=-80, yhi=150

# AUTO settings: continue in parameter W
@ parmin=-0.02, parmax=0.25, autoxmin=-2, autoxmax=2, autoymin=-80, autoymax=20
@ dsmin=1e-4, dsmax=0.1, nmax=500

done
